--- /dev/null
+++ b/test_archive.py
@@ -0,0 +1,76 @@
+import unittest
+
+from service import list_recipes, set_archived
+
+
+class ArchiveTests(unittest.TestCase):
+    def test_listing_filters_archived_and_preserves_legacy_order_and_copies(self):
+        rows = [
+            {"id": "hidden", "tenant": "one", "name": "Pie", "archived": True},
+            {"id": "legacy", "tenant": "one", "name": "Soup", "extra": 7},
+            {"id": "other", "tenant": "two", "name": "Cake"},
+            {"id": "active", "tenant": "one", "name": "Salad", "archived": False},
+        ]
+        before = [dict(row) for row in rows]
+        self.assertEqual(list_recipes(rows, "one"), [rows[1], rows[3]])
+        self.assertEqual(list_recipes(rows, "one", include_archived=False), [rows[1], rows[3]])
+        included = list_recipes(rows, "one", include_archived=True)
+        self.assertEqual(included, [rows[0], rows[1], rows[3]])
+        for row in included:
+            row["name"] = "Changed"
+        self.assertEqual(rows, before)
+        self.assertEqual(list_recipes([], "one"), [])
+        self.assertEqual(list_recipes([], "one", include_archived=True), [])
+        self.assertEqual(list_recipes(rows, "missing", include_archived=True), [])
+
+    def test_missing_cross_tenant_and_empty_catalog_raise_without_mutation(self):
+        for rows, recipe_id in (([], "a"),
+                                ([{"id": "a", "tenant": "two"}], "a"),
+                                ([{"id": "a", "tenant": "one"}], "missing")):
+            before = [dict(row) for row in rows]
+            for archived in (True, False):
+                with self.subTest(rows=rows, recipe_id=recipe_id, archived=archived):
+                    with self.assertRaises(LookupError):
+                        set_archived(rows, "one", "manager", recipe_id, archived)
+                    self.assertEqual(rows, before)
+
+    def test_archived_must_be_bool_without_mutation(self):
+        for archived in (0, 1, None, "false", "true", [], {}):
+            with self.subTest(archived=archived):
+                rows = [{"id": "a", "tenant": "one", "name": "Soup"}]
+                with self.assertRaises(ValueError):
+                    set_archived(rows, "one", "manager", "a", archived)
+                self.assertEqual(rows, [{"id": "a", "tenant": "one", "name": "Soup"}])
+
+    def test_other_roles_cannot_archive_or_restore(self):
+        for role in ("cook", "admin", "Manager", "", None):
+            for archived in (True, False):
+                with self.subTest(role=role, archived=archived):
+                    rows = [{"id": "a", "tenant": "one", "name": "Soup"}]
+                    with self.assertRaises(PermissionError):
+                        set_archived(rows, "one", role, "a", archived)
+                    self.assertEqual(rows, [{"id": "a", "tenant": "one", "name": "Soup"}])
+
+    def test_archive_restore_preserves_rows_and_returns_copies(self):
+        other_tenant = {"id": "a", "tenant": "two", "name": "Pie"}
+        target = {"id": "a", "tenant": "one", "name": "Soup", "cost": 5}
+        sibling = {"id": "b", "tenant": "one", "name": "Salad"}
+        rows = [other_tenant, target, sibling]
+        for archived in (True, True, False, False):
+            with self.subTest(archived=archived):
+                result = set_archived(rows, "one", "manager", "a", archived)
+                self.assertEqual(result, {
+                    "id": "a", "tenant": "one", "name": "Soup", "cost": 5,
+                    "archived": archived,
+                })
+                self.assertIs(rows[1], target)
+                self.assertEqual(target, result)
+                result["name"] = "Changed"
+                self.assertEqual(target["name"], "Soup")
+                self.assertEqual(rows[0], {"id": "a", "tenant": "two", "name": "Pie"})
+                self.assertEqual(rows[2], {"id": "b", "tenant": "one", "name": "Salad"})
+                self.assertEqual(len(rows), 3)
+
+
+if __name__ == "__main__":
+    unittest.main()
