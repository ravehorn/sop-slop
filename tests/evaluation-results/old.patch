 """Small tenant-scoped recipe catalog used only for workflow evaluation."""
 
 
-def list_recipes(rows, tenant):
-    return [dict(row) for row in rows if row["tenant"] == tenant]
+def list_recipes(rows, tenant, include_archived=False):
+    return [
+        dict(row) for row in rows
+        if row["tenant"] == tenant and (include_archived or not row.get("archived", False))
+    ]
 
 
 def set_archived(rows, tenant, role, recipe_id, archived):
-    raise NotImplementedError("Archive and restore are not implemented")
+    if role != "manager":
+        raise PermissionError("Only managers may archive or restore recipes")
+    if not isinstance(archived, bool):
+        raise ValueError("archived must be a bool")
+    for row in rows:
+        if row["tenant"] == tenant and row["id"] == recipe_id:
+            row["archived"] = archived
+            return dict(row)
+    raise LookupError("Recipe not found")
